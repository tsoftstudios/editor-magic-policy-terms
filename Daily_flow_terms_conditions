    p { margin: 0 0 16px; }
    h2 {
      margin: 32px 0 12px;
      padding-bottom: 9px;
      border-bottom: 1px solid var(--line);
      color: var(--purple-dark);
      font-size: 21px;
      line-height: 1.35;
    }
    ul { margin: 8px 0 18px; padding-left: 24px; }
    li { margin: 7px 0; padding-left: 3px; }
    a { color: var(--purple); overflow-wrap: anywhere; }
    footer { padding: 20px 10px 0; color: var(--muted); text-align: center; font-size: 13px; }
    @media (max-width: 600px) {
      body { padding: 18px 10px; }
      header { padding: 26px 22px; }
      main { padding: 25px 22px 32px; }
